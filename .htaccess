# /sammlung/.htaccess

# ---- Fehlerseiten ----
# Unbekannte Pfade liefern ein echtes 404 (kein Soft-404 mehr über index.php).
# /sammlung/ und /sammlung/museum/ laufen über DirectoryIndex.
ErrorDocument 404 /sammlung/404.php

# ---- Rewrite: bewusst keine Umschreibung ----
# Ohne eigenen Rewrite-Block greifen die Regeln der .htaccess im Webroot (WordPress) auch
# unter /sammlung/ und liefern für unbekannte Pfade die WordPress-404-Seite. Diese Regel
# schreibt nichts um, trennt /sammlung/ aber von den Webroot-Regeln ab.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sammlung/
  RewriteRule ^ - [L]
</IfModule>

# ---- Security: Verzeichnisse/Dateien sperren ----
# Keine Verzeichnisliste
Options -Indexes

# Standard-Startdatei
DirectoryIndex index.php

# Versteckte Dateien (+ sensible Dateitypen) sperren
# .sql/.md (Schema, Migrationen, README, CLAUDE.md), Backups und Vorlagen sind nie öffentlich.
# .json bleibt frei (museum/manifest.json).
<FilesMatch "(^\.|\.(ini|log|sh|sql|md|bak|dist|orig|old|swp|flag)$|~$|^composer\.|package\.json$|yarn\.lock$|^config\.php$|phpinfo\.php$)">
  Require all denied
</FilesMatch>

# Hilfsdateien sind nur zum Einbinden per PHP gedacht, nie per URL (include aus PHP bleibt möglich)
<FilesMatch "^(inc_[A-Za-z0-9_]+|boot|require_login|config\.example)\.php$">
  Require all denied
</FilesMatch>

# Typische Dev-/Backup-/Doku-Ordner hart auf 404
RedirectMatch 404 ^/sammlung/(vendor|node_modules|bin|backup|backups|dump|exports|docs|migrations|tests|\.claude|\.git)(/|$)

# ---- Security-Header ----
# Jeder Sicherheitsheader kommt aus genau EINER Stelle: hier. Auf PHP-Antworten erscheint jeder
# "always"-Header sonst doppelt (gemessen auf Strato, statische Dateien sind nicht betroffen).
# Darum werden die zusätzlichen Kopien zuerst entfernt. Wer hier einen Header ergänzt,
# nimmt die passende "onsuccess unset"-Zeile mit auf und prüft per curl -sI, dass er einmal kommt.
<IfModule mod_headers.c>
  Header onsuccess unset X-Content-Type-Options
  Header onsuccess unset X-Frame-Options
  Header onsuccess unset Referrer-Policy
  Header onsuccess unset Permissions-Policy
  Header onsuccess unset Strict-Transport-Security
  Header onsuccess unset Content-Security-Policy

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Kamera nur für die eigene Seite (Barcode-Scanner in edit.php)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"

  # HSTS stufenweise (E13): erst kurz. Nach einer Woche ohne Probleme (frühestens 20.10.2026)
  # auf max-age=31536000 erhöhen. includeSubDomains nur nach Prüfung aller Subdomains von
  # jungsi.de, weil der Session-Cookie auf .jungsi.de liegt.
  Header always set Strict-Transport-Security "max-age=300"

  # CSP (S9): ohne unsafe-inline, alle Seiten kommen ohne Inline-Stile und -Skripte aus.
  # unpkg.com nur für den Barcode-Fallback (ZXing, mit Prüfsumme in edit.js). Bilder dürfen von https-Adressen kommen.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self' https://unpkg.com; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
</IfModule>

# ---- Kompression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Caching statischer Dateien ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresDefault                         "access plus 1 day"
</IfModule>

# Korrektes MIME für SVG
AddType image/svg+xml .svg

# HTTPS: Die Weiterleitung http -> https übernimmt der Server (Strato), hier nicht nötig.
