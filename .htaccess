# /sammlung/.htaccess

# ---- Fehlerseiten ----
# Unbekannte Pfade liefern ein echtes 404 (kein Soft-404 mehr über index.php).
# /sammlung/ und /sammlung/museum/ laufen über DirectoryIndex.
ErrorDocument 404 /sammlung/404.php

# ---- Rewrite: bewusst keine Umschreibung ----
# Ohne eigenen Rewrite-Block greifen die Regeln der .htaccess im Webroot (WordPress) auch
# unter /sammlung/ und liefern für unbekannte Pfade die WordPress-404-Seite. Diese Regel
# schreibt nichts um, trennt /sammlung/ aber von den Webroot-Regeln ab.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sammlung/
  RewriteRule ^ - [L]
</IfModule>

# ---- Security: Verzeichnisse/Dateien sperren ----
# Keine Verzeichnisliste
Options -Indexes

# Standard-Startdatei
DirectoryIndex index.php

# Versteckte Dateien (+ sensible Dateitypen) sperren
# .sql/.md (Schema, Migrationen, README, CLAUDE.md), Backups und Vorlagen sind nie öffentlich.
# .json bleibt frei (museum/manifest.json).
<FilesMatch "(^\.|\.(ini|log|sh|sql|md|bak|dist|orig|old|swp)$|~$|^composer\.|package\.json$|yarn\.lock$|^config\.php$|phpinfo\.php$)">
  Require all denied
</FilesMatch>

# Typische Dev-/Backup-/Doku-Ordner hart auf 404
RedirectMatch 404 ^/sammlung/(vendor|node_modules|bin|backup|backups|dump|exports|docs|migrations|tests|\.claude|\.git)(/|$)

# ---- Security-Header ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Vorsichtige CSP (lässt inline Styles/Skripte der bestehenden Seiten zu)
  Header set Content-Security-Policy "default-src 'self' https: data:; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' https:; script-src 'self' https: 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
</IfModule>

# ---- Kompression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Caching statischer Dateien ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresDefault                         "access plus 1 day"
</IfModule>

# Korrektes MIME für SVG
AddType image/svg+xml .svg

# ---- Optional: HTTPS erzwingen (falls nicht bereits global aktiv) ----
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
